# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server only. Never prefix this with NEXT_PUBLIC_ or expose to browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY

# Mux Dashboard -> Settings -> Access Tokens. Video Read + Write permissions.
# These values stay server-side; never use NEXT_PUBLIC_ for them.
MUX_TOKEN_ID=YOUR_MUX_TOKEN_ID
MUX_TOKEN_SECRET=YOUR_MUX_TOKEN_SECRET
# Mux Dashboard -> Settings -> Signing Keys. Copy both values when creating the key.
MUX_SIGNING_KEY_ID=YOUR_MUX_SIGNING_KEY_ID
MUX_SIGNING_PRIVATE_KEY=YOUR_BASE64_ENCODED_MUX_PRIVATE_KEY
# Mux Dashboard -> Settings -> Webhooks -> endpoint signing secret.
MUX_WEBHOOK_SECRET=YOUR_MUX_WEBHOOK_SIGNING_SECRET

# Only needed to play or delete media uploaded to R2 before switching to Mux.
# New uploads never use R2.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=freeframe-media

# Required for Google OAuth redirect URI; set to localhost or your exact deployed HTTPS domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Web Client
# Use the SAME client ID/secret in the Supabase Google Auth provider.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_WEB_CLIENT_SECRET
# Any cryptographically random 32+ characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHAR_SECRET
